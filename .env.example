LLM_API_KEY=your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=llama-3.3-70b-versatile
RATE_LIMIT_RPM=30
RATE_LIMIT_TPM=12000
SPACY_MODEL=en_core_web_sm

