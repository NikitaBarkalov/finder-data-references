      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Emergence, Evolution, and Pathogenicity of Influenza A(H7N4) Virus in Shorebirds in China</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
